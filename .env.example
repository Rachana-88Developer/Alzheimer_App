# ---- Database ----
POSTGRES_USER=cdss
POSTGRES_PASSWORD=cdss_password
POSTGRES_DB=cdss_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend uses this directly. For local (non-docker) use, set host to localhost.
DATABASE_URL=postgresql+psycopg2://cdss:cdss_password@db:5432/cdss_db

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- App ----
SEED_DEFAULT_USERS=true
AUTO_TRAIN_MODEL=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
